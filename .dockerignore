# Only requirements.txt, graphs.py, and spacex_graphs/ are copied into the
# image; excluding everything else keeps the build context small

# Git and Docker
.git
.gitignore
Dockerfile
docker-compose.yml
.dockerignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage

# Project files the image doesn't need
.cache/
.claude/
.github/
outputs/
scripts/
tests/
AGENTS.md
CLAUDE.local.md

# Editors
.idea
.vscode
*.swp
